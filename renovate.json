{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],

  // turn on automerge only for safe updates
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },

    // group dev-deps weekly (npm)
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies", "dev-dependencies", "dev"],
      "groupName": "npm dev-deps (weekly)",
      "schedule": ["before 3am on Monday"]
    },

    // keep non-major updates grouped PER manager (not across managers)
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "npm non-major"
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "pip non-major"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "docker non-major"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "actions non-major"
    }
  ],

  // limit managers you actually use in this repo
  "enabledManagers": ["npm", "pip_requirements", "dockerfile", "github-actions"],

  // optional: a dashboard issue with controls
  "dependencyDashboard": true
}

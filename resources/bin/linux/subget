#!/usr/bin/env python3
"""Stub wrapper for the Subget helper binary.

This repository cannot ship real binaries in pull requests, so this
lightweight Python shim exists purely for development and test
environments. The real build process should replace this file with the
platform specific executable produced from the upstream subget fork.

When invoked with ``--json-search`` the stub emits a deterministic error
payload so that callers can gracefully fall back to the legacy parser.
The ``--download`` mode writes a short explanatory message to stderr and
returns a non-zero exit code for the same reason.
"""

from __future__ import annotations

import argparse
import json
import sys


def _handle_search(query: str) -> int:
    payload = {
        "ok": False,
        "error": "subget stub binary – real helper missing",
        "query": query,
    }
    json.dump(payload, sys.stdout)
    sys.stdout.write("\n")
    return 1


def _handle_download(detail: str, lang: str, use_stdout: bool) -> int:
    sys.stderr.write(
        "subget stub binary – download helper is not available in development builds\n"
    )
    return 1


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="subget-stub")
    parser.add_argument("--json-search", dest="json_search")
    parser.add_argument("--download", dest="download")
    parser.add_argument("--lang", dest="lang")
    parser.add_argument("--stdout", action="store_true")
    args = parser.parse_args(argv)

    if args.json_search:
        return _handle_search(args.json_search)
    if args.download:
        return _handle_download(args.download, args.lang or "", args.stdout)

    parser.print_usage()
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
